rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /clientes/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /presupuestos/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}

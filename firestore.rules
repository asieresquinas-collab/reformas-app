rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /clientes/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /presupuestos/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    match /firmas/{token} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null
        || (resource.data.firma == null
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['firma','nombreFirma','dni','fechaFirma','aceptado','visto']));
    }
    match /seguimiento/{token} {
      allow read: if true;
      allow write: if request.auth != null;
      match /fotos/{foto} {
        allow read: if true;
        allow write: if request.auth != null;
        // el cliente, sin cuenta, solo puede contestar a un imprevisto que aun no ha contestado
        allow update: if request.auth == null
          && resource.data.tipo == 'imprevisto'
          && !('respuesta' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respuesta','fechaRespuesta'])
          && request.resource.data.respuesta in ['aceptado','rechazado'];
      }
    }
  }
}
